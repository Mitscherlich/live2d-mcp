  "flows": [
    {
      "id": "flow-mcp-visual-command",
      "name": "MCP 视觉命令 → Renderer",
      "summary": "Agent 经 Streamable HTTP MCP 调用表情/动作等工具，main 经命令通道转发到 Live2D renderer 执行。",
      "steps": [
        "mcp-client",
        "bridge-server",
        "mcp-server",
        "electron-main",
        "cmd-channel",
        "avatar-preload",
        "renderer-main",
        "live2d-app"
      ]
    },
    {
      "id": "flow-mcp-window-control",
      "name": "MCP 窗口控制",
      "summary": "control_window show|hide|toggle 由 main 直接作用角色窗，不经 renderer 命令通道。",
      "steps": [
        "mcp-client",
        "bridge-server",
        "mcp-server",
        "electron-main"
      ]
    },
    {
      "id": "flow-events-lipsync",
      "name": "POST /events → 口型",
      "summary": "外部 HTTP 注入 state/audio-level，经权威规范化与 IPC 到达 renderer 口型链路。",
      "steps": [
        "http-client",
        "bridge-server",
        "voice-events",
        "electron-main",
        "avatar-preload",
        "renderer-main",
        "voice-state",
        "lip-sync",
        "live2d-app"
      ]
    },
    {
      "id": "flow-native-lipsync",
      "name": "Native Listener → 口型",
      "summary": "macOS process tap 捕获 agent 出声进程电平，与 /events 汇合到同一 sendVoiceEvent 路径驱动嘴型。",
      "steps": [
        "agent-audio-process",
        "native-helper",
        "native-process-listener",
        "electron-main",
        "voice-events",
        "avatar-preload",
        "renderer-main",
        "voice-state",
        "lip-sync",
        "live2d-app"
      ]
    },
    {
      "id": "flow-health-status",
      "name": "GET /health 状态摘要",
      "summary": "只读健康检查：bridge 端口、voice 摘要、listener 真实状态、MCP URL 等（不含用户内容）。",
      "steps": [
        "http-client",
        "bridge-server",
        "electron-main",
        "listener-status"
      ]
    },
    {
      "id": "flow-mcp-get-status",
      "name": "MCP get_status",
      "summary": "只读状态工具：窗口/bridge/voice/listener/mcp；模型就绪经命令通道往返 renderer。",
      "steps": [
        "mcp-client",
        "bridge-server",
        "mcp-server",
        "electron-main",
        "listener-status",
        "cmd-channel",
        "avatar-preload",
        "renderer-main",
        "live2d-app"
      ]
    },
    {
      "id": "flow-tray-lifecycle",
      "name": "托盘与窗口生命周期",
      "summary": "托盘显示/隐藏/设置/退出；关闭角色窗 hide 保活 bridge 与 renderer。",
      "steps": [
        "tray",
        "electron-main",
        "avatar-preload",
        "renderer-main"
      ]
    },
    {
      "id": "flow-settings-voice-update",
      "name": "设置页更新 Voice Source",
      "summary": "设置 UI 保存 voice source → 原子写入 settings.json → 无 env 覆盖时热重启 listener。",
      "steps": [
        "settings-ui",
        "settings-preload",
        "settings-channels",
        "electron-main",
        "settings-store",
        "settings-json",
        "voice-source",
        "audio-listener",
        "native-process-listener"
      ]
    },
    {
      "id": "flow-desktop-drag-scale",
      "name": "桌面拖拽 / 缩放",
      "summary": "renderer 交互判定后经 preload 窄 IPC 请求 main 调整角色窗 bounds/scale。",
      "steps": [
        "renderer-main",
        "desktop-interactions",
        "avatar-preload",
        "window-interactions",
        "electron-main"
      ]
    },
    {
      "id": "flow-app-boot",
      "name": "应用启动编排",
      "summary": "main 注册协议与通道，启动 bridge/MCP/listener，创建角色窗经 preload 加载 Live2D。",
      "steps": [
        "electron-main",
        "renderer-protocol",
        "bridge-server",
        "mcp-server",
        "voice-source",
        "audio-listener",
        "settings-store",
        "tray",
        "avatar-preload",
        "renderer-main",
        "live2d-app"
      ]
    }
  ]
}
