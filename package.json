{
  "name": "live2d-mcp",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "renderer"
  ],
  "scripts": {
    "dev": "bun scripts/dev-electron.mjs",
    "dev:electron": "bun scripts/dev-electron.mjs",
    "start": "electron .",
    "build": "bun run --filter renderer build && bun run build:electron",
    "build:electron": "node scripts/check-electron-syntax.mjs",
    "build:native": "sh scripts/build-native-helper.sh",
    "test": "node --test 'electron/test/**/*.test.cjs' 'renderer/test/**/*.test.ts'",
    "proof:f3": "node scripts/f3-lipsync-proof.mjs",
    "proof:f4": "node scripts/f4-bridge-proof.mjs",
    "proof:f5": "node scripts/f5-mcp-proof.mjs",
    "proof:f6": "node scripts/f6-listener-proof.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "electron": "39.8.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  }
}
